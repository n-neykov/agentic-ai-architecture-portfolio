# Project 01 — Azure AI Foundry (keep actual values only in untracked .env)
# Foundry project endpoint or the exact /openai/v1/responses URL.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT/openai/v1/responses
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Only used with legacy .openai.azure.com AzureChatOpenAI resource endpoints:
AZURE_OPENAI_API_VERSION=2024-10-21
